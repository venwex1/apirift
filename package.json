{
  "name": "apirift",
  "version": "1.0.0",
  "private": true,
  "description": "ApiRift watches every API your product depends on and tells you what will break you, before it does.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "email:dev": "email dev --dir emails",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.39.0",
    "@aws-sdk/client-s3": "3.716.0",
    "@clerk/nextjs": "6.12.0",
    "@clerk/themes": "2.4.62",
    "@prisma/client": "6.4.1",
    "@react-email/components": "0.0.33",
    "@sentry/nextjs": "8.55.0",
    "@upstash/ratelimit": "2.0.5",
    "@upstash/redis": "1.34.4",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "11.18.2",
    "gray-matter": "4.0.3",
    "lucide-react": "0.475.0",
    "next": "15.3.9",
    "next-mdx-remote": "6.0.0",
    "posthog-js": "1.215.1",
    "posthog-node": "4.5.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "4.1.2",
    "sonner": "1.7.4",
    "stripe": "17.6.0",
    "svix": "1.45.1",
    "tailwind-merge": "3.0.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@clerk/testing": "^1.4.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.20.1",
    "eslint-config-next": "15.3.9",
    "postcss": "8.5.2",
    "prisma": "6.4.1",
    "react-email": "3.0.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}