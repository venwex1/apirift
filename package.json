{
  "name": "apirift",
  "version": "1.0.0",
  "private": true,
  "description": "ApiRift watches every API your product depends on and tells you what will break you, before it does.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "email:dev": "email dev --dir emails",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@vercel/speed-insights": "1.3.1",
    "@aws-sdk/client-s3": "3.1095.0",
    "@clerk/nextjs": "6.39.6",
    "@clerk/themes": "2.4.63",
    "@prisma/client": "6.19.3",
    "@react-email/components": "0.0.33",
    "@sentry/nextjs": "8.55.2",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "framer-motion": "11.18.2",
    "gray-matter": "4.0.3",
    "lucide-react": "0.577.0",
    "next": "15.5.22",
    "next-mdx-remote": "6.0.0",
    "posthog-js": "1.407.3",
    "posthog-node": "4.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "4.8.0",
    "sonner": "1.7.4",
    "stripe": "17.7.0",
    "svix": "1.99.1",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@clerk/testing": "^1.14.9",
    "@playwright/test": "^1.62.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "postcss": "8.5.23",
    "prisma": "6.19.3",
    "react-email": "3.0.7",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
