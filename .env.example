# ── App ──────────────────────────────────────────────────────────────────────
# Canonical public URL of the deployment (no trailing slash).
NEXT_PUBLIC_APP_URL="https://upstream.watch"

# ── Database (Neon) ──────────────────────────────────────────────────────────
# Pooled connection string (pgbouncer) — used by the app at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/upstream?sslmode=require&pgbouncer=true&connection_limit=10"
# Direct connection — used only by `prisma migrate`.
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/upstream?sslmode=require"

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_xxx"
CLERK_SECRET_KEY="sk_live_xxx"
# Signing secret for the Clerk -> /api/webhooks/clerk webhook (user.created sync).
CLERK_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ── Payments (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# Price IDs created in the Stripe dashboard (see docs/LAUNCH.md step 3).
STRIPE_PRICE_PRO_MONTHLY="price_xxx"
STRIPE_PRICE_PRO_YEARLY="price_xxx"
STRIPE_PRICE_TEAM_MONTHLY="price_xxx"
STRIPE_PRICE_TEAM_YEARLY="price_xxx"

# ── AI (Anthropic) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-xxx"
# Hard daily cap on classification calls. Beyond it, changes queue for tomorrow.
AI_DAILY_CALL_BUDGET="2000"

# ── Cache & rate limiting (Upstash Redis) ────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxx"
# Verified sending domain address.
EMAIL_FROM="Upstream <signal@upstream.watch>"
# Feedback replies (day-14 email) land here.
FOUNDER_EMAIL="you@example.com"

# ── Storage (Cloudflare R2, S3-compatible) ───────────────────────────────────
R2_ACCOUNT_ID="xxx"
R2_ACCESS_KEY_ID="xxx"
R2_SECRET_ACCESS_KEY="xxx"
R2_BUCKET="upstream-backups"

# ── Monitoring ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_ORG="your-org"
SENTRY_PROJECT="upstream"
SENTRY_AUTH_TOKEN="sntrys_xxx"

# ── Analytics (PostHog) ──────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_xxx"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ── Cron ─────────────────────────────────────────────────────────────────────
# Random 32+ char secret; Vercel sends it as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="generate-a-long-random-string-here"
