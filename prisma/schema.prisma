generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  PRO
  TEAM
}

enum ChangeKind {
  BREAKING     // removes or alters behavior existing integrations rely on
  DEPRECATION  // announced future removal with a deadline
  INCIDENT     // outage or degraded service
  SECURITY     // vulnerability disclosure or forced rotation
  FEATURE      // net-new capability
  MAINTENANCE  // scheduled windows, infra notices
  NOTICE       // pricing, policy, terms
}

enum Severity {
  CRITICAL // will break production for affected integrations
  HIGH     // action required before a deadline
  MEDIUM   // action recommended
  LOW      // awareness only
  INFO     // no action
}

enum ClassificationStatus {
  PENDING
  CLASSIFIED
  FAILED // exceeded max attempts; surfaced unclassified rather than dropped
}

enum AlertChannel {
  EMAIL
  WEBHOOK
  DIGEST
}

enum ReferralStatus {
  PENDING   // referred user signed up
  CONVERTED // referred user paid
  REWARDED  // both sides credited
}

enum SourceType {
  RSS
  JSON
  HTML
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & billing
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                   String    @id // Clerk user id
  email                String    @unique
  name                 String?
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  planRenewsAt         DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  attributionRemoved   Boolean   @default(false) // Pro perk: hide "Watched by Upstream" on shared reports
  referralCode         String    @unique
  referredById         String?
  referredBy           User?     @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals            User[]    @relation("UserReferrals")
  lastActiveAt         DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  watches       Watch[]
  projects      Project[]
  alerts        Alert[]
  impactReports ImpactReport[]
  emailLogs     EmailLog[]
  usage         UsageCounter[]
  referralsMade Referral[]     @relation("Referrer")

  @@index([referredById])
  @@index([plan])
}

// ─────────────────────────────────────────────────────────────────────────────
// The registry: providers and their signal sources.
// This is the moat. Every row of Change history compounds.
// ─────────────────────────────────────────────────────────────────────────────

model Provider {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  category  String // "payments" | "ai" | "auth" | "email" | "infra" | ...
  homepage  String
  docsUrl   String?
  // npm package names that map to this provider, for manifest impact analysis.
  npmPackages String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sources Source[]
  changes Change[]
  watches Watch[]

  @@index([category])
}

model Source {
  id                  String     @id @default(cuid())
  providerId          String
  provider            Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type                SourceType
  url                 String
  // Content hash of the last successful fetch; unchanged hash short-circuits parsing.
  lastHash            String?
  lastCheckedAt       DateTime?
  lastOkAt            DateTime?
  consecutiveFailures Int        @default(0)
  enabled             Boolean    @default(true)
  createdAt           DateTime   @default(now())

  changes Change[]

  @@unique([providerId, url])
  @@index([enabled, lastCheckedAt])
}

model Change {
  id                     String               @id @default(cuid())
  providerId             String
  provider               Provider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  sourceId               String?
  source                 Source?              @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  // sha256(url + title): dedupe key across repeated polls of the same source.
  externalKey            String
  title                  String
  url                    String?
  publishedAt            DateTime?
  rawExcerpt             String               @db.Text
  status                 ClassificationStatus @default(PENDING)
  classificationAttempts Int                  @default(0)
  classifiedAt           DateTime?
  kind                   ChangeKind?
  severity               Severity?
  summary                String?              @db.Text
  affectedSurfaces       String[]             @default([]) // e.g. ["charges API", "webhook signatures"]
  actionRequired         String?              @db.Text
  effectiveAt            DateTime? // sunset / enforcement deadline, when stated
  createdAt              DateTime             @default(now())

  alerts Alert[]

  @@unique([providerId, externalKey])
  @@index([status, classificationAttempts])
  @@index([providerId, createdAt(sort: Desc)])
  @@index([severity, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// User workspace
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // Raw parsed manifest (package.json dependencies), stored for re-analysis.
  manifest   Json?
  // Team plan: outgoing webhook receiving alert payloads.
  webhookUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  watches       Watch[]
  impactReports ImpactReport[]

  @@index([userId])
}

model Watch {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  muted      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([userId, providerId])
  @@index([providerId])
  @@index([userId])
}

model Alert {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  changeId  String
  change    Change       @relation(fields: [changeId], references: [id], onDelete: Cascade)
  channel   AlertChannel
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime     @default(now())

  // Fan-out idempotency: one alert per user × change × channel, ever.
  @@unique([userId, changeId, channel])
  @@index([userId, createdAt(sort: Desc)])
  @@index([sentAt])
}

model ImpactReport {
  id               String   @id @default(cuid())
  publicId         String   @unique @default(cuid()) // shareable URL id
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  manifest         Json
  matchedProviders String[] @default([])
  // Array of { providerSlug, changeId, severity, kind, title, note }
  findings         Json
  attributionShown Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// Growth
// ─────────────────────────────────────────────────────────────────────────────

model Referral {
  id          String         @id @default(cuid())
  referrerId  String
  referrer    User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId  String         @unique // one reward per referred user, ever
  status      ReferralStatus @default(PENDING)
  convertedAt DateTime?
  rewardedAt  DateTime?
  createdAt   DateTime       @default(now())

  @@index([referrerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Operations
// ─────────────────────────────────────────────────────────────────────────────

// Stripe/Clerk webhook idempotency ledger. Insert-or-skip on event id.
model WebhookEvent {
  id          String   @id // provider event id (evt_..., msg_...)
  source      String // "stripe" | "clerk"
  type        String
  processedAt DateTime @default(now())

  @@index([source, processedAt])
}

// Lifecycle email idempotency: each template sends at most once per user.
model EmailLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template String // "welcome" | "day3_active" | ...
  sentAt   DateTime @default(now())

  @@unique([userId, template])
  @@index([userId])
}

// Metered feature usage, keyed by calendar month.
model UsageCounter {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric String // "impact_reports"
  period String // "2026-07"
  count  Int    @default(0)

  @@unique([userId, metric, period])
}

// Structured record of every cron execution. Two consecutive failures of the
// same job trigger a Sentry alert (checked inside the cron wrapper).
model CronRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  detail     String?   @db.Text

  @@index([job, startedAt(sort: Desc)])
}
